<div class="main">
    <form   hx-post="/get-commande-by-email"
            hx-target="#result"
            hx-swap="innerHTML"
            hx-on=
                "htmx:beforeRequest: document.getElementById('loader').style.visibility = 'visible'
                htmx:afterRequest: document.getElementById('loader').style.visibility = 'hidden'
                ">
        <label for="email">
            Veuillez saisir l'adresse e-mail utilisée lors de votre commande.
            Vous recevrez un lien par mail pour accéder à vos billets.
        </label>
        <input type="email" name="email" placeholder="Votre addresse mail." />
        <button class="send-button" type="submit">Recevoir mon lien</button>

    </form>

    <div id="result"></div>
    <div id="loader" class="spinner" style="visibility: hidden;"></div>
</div>